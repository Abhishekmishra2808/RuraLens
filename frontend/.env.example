# Frontend Environment Variables
# Copy this to .env.local and update with your actual values

# Backend API URL (use your Render backend URL in production)
VITE_API_URL=https://your-backend-name.onrender.com

# Cesium ion access token for the 3D digital twin (terrain, imagery, OSM Buildings).
# Create one at https://ion.cesium.com/tokens. VITE_* variables are embedded in the
# browser bundle, so treat this as a public client credential: restrict it to the
# assets you need and to your deployed domains in the Cesium ion dashboard.
# Without it the twin falls back to OpenStreetMap imagery on a flat globe (no buildings).
VITE_CESIUM_ION_TOKEN=

# Note: In development, the app will automatically use http://localhost:3001
