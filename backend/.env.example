# Server Configuration
PORT=3001
NODE_ENV=development

# Python GNN Model API URL
# Local development:
PYTHON_GNN_API_URL=http://localhost:8001
# Production example:
# PYTHON_GNN_API_URL=https://ruralens-gnn-api.onrender.com

# Amazon Bedrock (Copilot + vendor report comparison) - see docs/BEDROCK.md
# Bedrock is called only from this backend; never put AWS values in frontend VITE_ variables.
AWS_REGION=us-east-1
# Model ID or inference profile ID you have enabled in the Bedrock console.
# It must support the Converse API with tool use (e.g. Anthropic Claude 3+ or Amazon Nova).
BEDROCK_MODEL_ID=
# Which Bedrock API to call: converse (default, Bedrock Runtime) or openai (the
# OpenAI-compatible Chat Completions endpoint, bedrock-mantle). openai requires
# AWS_BEARER_TOKEN_BEDROCK and a model served there, e.g. BEDROCK_MODEL_ID=openai.gpt-oss-120b
# BEDROCK_API=converse
# Optional override; defaults to https://bedrock-mantle.<AWS_REGION>.api.aws/v1
# BEDROCK_OPENAI_BASE_URL=
# Optional tuning (defaults shown)
# BEDROCK_MAX_TOKENS=2048
# BEDROCK_TIMEOUT_MS=30000
# BEDROCK_MAX_ATTEMPTS=3
# BEDROCK_TEMPERATURE=0.2

# AWS credentials are resolved by the AWS SDK default credential chain
# (environment variables, shared ~/.aws profile via AWS_PROFILE, SSO, or an attached role).
# Prefer AWS_PROFILE locally. Only if you must use static keys, set them here - never commit them:
# AWS_PROFILE=ruralens-dev
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Alternatively, an Amazon Bedrock API key. When set it takes precedence over the keys above.
# Leave it commented out unless you have a value: the AWS SDK uses it even when empty.
# AWS_BEARER_TOKEN_BEDROCK=

# Maximum PDF pages read for vendor report / scheme plan text extraction
# PDF_MAX_PAGES=60

# Natural-language query cache (seconds)
RAG_CACHE_TTL_SECONDS=120

# MongoDB Configuration
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/ruralens
# Or use MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=<appname>

# JWT Secret (IMPORTANT: Change this in production!)
JWT_SECRET=your-secret-key-change-this-in-production-2026

# Gemini AI API Key
# Get your free API key from: https://aistudio.google.com/app/apikey
# Free tier: 10 requests/min, 250K tokens/min, 250 requests/day
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face API Key (used by RAG + other backend AI features)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Default Admin Credentials (created on first run)
ADMIN_EMAIL=admin@ruralens.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator

# Ringg AI Integration
# Base URL from Ringg API docs
RINGG_API_BASE_URL=https://prod-api.ringg.ai/ca/api/v0
# Your Ringg workspace API key
RINGG_API_KEY=your_ringg_api_key_here
# Default assistant (agent) ID for fetching latest call summaries
RINGG_ASSISTANT_ID=your_ringg_assistant_id_here

