# @strands-agents/sdk declares an optional peer on express@^5 for its own server
# integration, which this backend does not use (it runs Express 4). The peers it
# needs at runtime (zod, @opentelemetry/api, and @modelcontextprotocol/client,
# which its entry point imports even though MCP is unused here) are listed
# explicitly in package.json.
legacy-peer-deps=true
