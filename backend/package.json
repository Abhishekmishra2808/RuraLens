    "@modelcontextprotocol/client": "^2.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@strands-agents/sdk": "^1.20.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "ollama": "^0.5.0",
    "openai": "^6.49.0",
