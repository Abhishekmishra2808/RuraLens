{
  "name": "ruralens-backend",
  "version": "1.0.0",
  "description": "Backend server for RuraLens with GNN integration",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "clear-db": "node clearDB.js",
    "cleanup-feedback": "node cleanupFeedback.js",
    "migrate-locations": "node scripts/migrate-location-fields.js",
